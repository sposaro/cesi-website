---
import Site from '../layouts/Site.astro';
---
<Site
    title='Contact — The CESI Project'
    description='Contact The CESI Project for partnerships, verification, volunteering, or general inquiries.'
    ogTitle='Contact — The CESI Project'
    ogDescription='Get in touch with The CESI Project.'
    active="contact"
>


        <section class="hero">
            <div class="hero-grid">
                <div class="card">
                    <h1 class="h1">Contact</h1>
                    <p class="lede">
                        For partnerships, verification, volunteering, or general inquiries:
                    </p>

                    <div class="cta-row">
                        <a class="btn primary" href="mailto:secretary@cesi.earth">Email us</a>
                    </div>

                    <div class="pills">
                        <span class="pill">EIN: 41-2621387</span>
                        <span class="pill">secretary@cesi.earth</span>
                    </div>
                </div>

                <div class="card">
                    <h2 style="margin:0 0 10px;">Support our mission</h2>
                    <p class="lede">
                        Donations directly support CESI conservation, education, and sustainability initiatives.
                    </p>
                    <a class="btn primary"
                       href="https://www.zeffy.com/en-US/donation-form/conservation-education-sustainability"
                       target="_blank"
                       rel="noopener noreferrer">
                        Donate
                    </a>
                </div>
            </div>
        </section>
</Site>
