---
import Site from '../layouts/Site.astro';
---
<Site
    title='Legal & Verification — The CESI Project'
    description='Legal and verification information for The CESI Project (EIN 41-2621387).'
    ogTitle='Legal & Verification — The CESI Project'
    ogDescription='Nonprofit verification details for corporate giving programs.'
    active="legal"
>


        <section class="hero">
            <div class="hero-grid">
                <div class="card">
                    <h1 class="h1">Legal & Verification</h1>
                    <p class="lede">
                        This page contains details commonly requested for nonprofit verification and corporate giving / employee matching programs.
                    </p>

                    <div class="cta-row">
                        <a class="btn primary" href="mailto:secretary@cesi.earth">Email verification contact</a>
                        <a class="btn"
                           href="https://www.zeffy.com/en-US/donation-form/conservation-education-sustainability"
                           target="_blank"
                           rel="noopener noreferrer">Donate</a>
                    </div>

                    <div class="pills">
                        <span class="pill">EIN: 41-2621387</span>
                        <span class="pill">secretary@cesi.earth</span>
                    </div>

                    <p class="small" style="margin-top:12px;">
                        If you need additional documentation for verification, email us and we’ll respond with the requested records.
                    </p>
                </div>

                <div class="card">
                    <h2 style="margin:0 0 10px;">Verification summary</h2>

                    <div class="kv"><div class="small">Public name</div><div>The CESI Project</div></div>
                    <div class="kv"><div class="small">EIN</div><div>41-2621387</div></div>
                    <div class="kv"><div class="small">Website</div><div><a href="https://cesi.earth">https://cesi.earth</a></div></div>
                    <div class="kv"><div class="small">Verification email</div><div><a href="mailto:secretary@cesi.earth">secretary@cesi.earth</a></div></div>

                    <p class="small" style="margin-top:12px;">
                        The CESI Project is the operating name (DBA) of <strong>Sposaro Conservation, Education, Sustainability, Initiative INC</strong>.
                    </p>
                </div>
            </div>
        </section>

        <section class="section">
            <h2>For corporate giving & matching</h2>
            <div class="grid3">
                <div class="card">
                    <h3 style="margin-top:0;">How to verify</h3>
                    <p class="small">
                        Use the EIN and contact email above. If your portal requires a document upload,
                        request it via email and we will provide it.
                    </p>
                </div>
                <div class="card">
                    <h3 style="margin-top:0;">Preferred listing name</h3>
                    <p class="small">
                        Please list the organization publicly as <strong>The CESI Project</strong>.
                    </p>
                </div>
                <div class="card">
                    <h3 style="margin-top:0;">Donation processing</h3>
                    <p class="small">
                        Donations are processed securely via Zeffy:
                    </p>
                    <a class="btn primary"
                       href="https://www.zeffy.com/en-US/donation-form/conservation-education-sustainability"
                       target="_blank"
                       rel="noopener noreferrer">Donate via Zeffy</a>
                </div>
            </div>
        </section>

        <section class="section">
            <h2>Documents</h2>
            <p class="small" style="margin-top:-6px;">
                Add PDFs to <code>assets/docs/</code> and link them here as they become available.
            </p>

            <div class="grid3">
                <div class="card">
                    <h3 style="margin-top:0;">IRS determination letter</h3>
                    <p class="small">Link when available.</p>
                    <p class="small"><code>assets/docs/irs-determination-letter.pdf</code></p>
                </div>
                <div class="card">
                    <h3 style="margin-top:0;">Form 990 / 990-EZ / 990-N</h3>
                    <p class="small">Most recent annual filing, when available.</p>
                    <p class="small"><code>assets/docs/form-990.pdf</code></p>
                </div>
                <div class="card">
                    <h3 style="margin-top:0;">State registration / articles</h3>
                    <p class="small">Articles of incorporation and related state documents — view the official filing on the Florida Division of Corporations (Sunbiz):</p>
                    <p class="small"><a href="https://search.sunbiz.org/Inquiry/CorporationSearch/SearchResultDetail?inquirytype=EntityName&directionType=Initial&searchNameOrder=SPOSAROCONSERVATIONEDUCATIONSU%20N250000147960&aggregateId=domnp-n25000014796-927a5ec5-7086-44b2-8a22-fc7ed90cb0f7&searchTerm=sposaro&listNameOrder=SPOSAROCONSERVATIONEDUCATIONSU%20N250000147960" target="_blank" rel="noopener noreferrer">Sunbiz entity record (Sposaro Conservation, Education, Sustainability, Initiative INC)</a></p>
                </div>
            </div>
        </section>

        <section class="section">
            <h2>Quick FAQ</h2>
            <div class="grid3">
                <div class="card">
                    <h3 style="margin-top:0;">Why do I see two names?</h3>
                    <p class="small">
                        The CESI Project is the public operating name. Some systems require the legal entity name for verification.
                    </p>
                </div>
                <div class="card">
                    <h3 style="margin-top:0;">What’s the EIN?</h3>
                    <p class="small"><strong>41-2621387</strong></p>
                </div>
                <div class="card">
                    <h3 style="margin-top:0;">Where should questions go?</h3>
                    <p class="small">
                        Email <a href="mailto:secretary@cesi.earth"><strong>secretary@cesi.earth</strong></a>.
                    </p>
                </div>
            </div>
        </section>
</Site>
