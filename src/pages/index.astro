---
import Site from '../layouts/Site.astro';
import SwanMark from '../components/SwanMark.astro';
---
<Site
    title='The CESI Project'
    description='The CESI Project promotes conservation, education, and sustainability of Earth’s ecosystems through exploration, research, restoration, stewardship, and global community engagement.'
    ogTitle='The CESI Project'
    ogDescription='Advancing conservation, education, and sustainability through stewardship and community engagement.'
    active="home"
>


        <!-- HERO -->
        <section class="hero">
            <div class="hero-grid">

                <!-- LEFT CARD -->
                <div class="card">
                    <h1 class="h1">Advancing Conservation, Education, and Sustainability</h1>

                    <p class="lede">
                        Our mission is to promote conservation, education, and sustainability of Earth’s ecosystems and environments through exploration,
                        research, restoration, environmental stewardship, and global community engagement.
                    </p>

                    <div class="cta-row">
                        <a class="btn primary"
                           href="https://www.zeffy.com/en-US/donation-form/conservation-education-sustainability"
                           target="_blank"
                           rel="noopener noreferrer">
                            Donate
                        </a>
                        <a class="btn" href="/contact.html">Get in touch</a>
                        <a class="btn" href="/legal.html">Verification info</a>
                    </div>

                    <div class="pills">
                        <span class="pill">EIN: 41-2621387</span>
                        <span class="pill">Email: secretary@cesi.earth</span>
                    </div>

                    <p class="small" style="margin-top:12px;">
                        Donations are processed securely via Zeffy.
                    </p>
                </div>

                <!-- RIGHT CARD (TABLE STYLE) -->
                <div class="card">
                    <h2 style="margin:0 0 10px;">Trust & Verification</h2>

                    <div class="kv">
                        <div class="small">Public name</div>
                        <div>The CESI Project</div>
                    </div>
                    <div class="kv">
                        <div class="small">Legal entity</div>
                        <div>Sposaro Conservation, Education, Sustainability, Initiative INC</div>
                    </div>
                    <div class="kv">
                        <div class="small">EIN</div>
                        <div>41-2621387</div>
                    </div>
                    <div class="kv">
                        <div class="small">Primary contact</div>
                        <div><a href="mailto:secretary@cesi.earth">secretary@cesi.earth</a></div>
                    </div>

                    <p class="small" style="margin-top:12px;">
                        Corporate giving and verification teams may use this information or visit the Legal page.
                    </p>

                    <div class="cta-row" style="margin-top:14px;">
                        <a class="btn" href="/legal.html">Legal details</a>
                        <a class="btn" href="mailto:secretary@cesi.earth">Email</a>
                    </div>
                </div>

            </div>
        </section>

        <!-- PROGRAMS -->
        <section class="section" id="programs">
            <h2>Core programs</h2>
            <div class="grid3">
                <div class="card">
                    <h3 style="margin-top:0;">Conservation & Restoration</h3>
                    <p class="small">Hands-on stewardship and restoration projects focused on protecting ecosystems and habitats.</p>
                </div>
                <div class="card">
                    <h3 style="margin-top:0;">Education & Outreach</h3>
                    <p class="small">Learning experiences and outreach that promote environmental understanding and responsible action.</p>
                </div>
                <div class="card">
                    <h3 style="margin-top:0;">Exploration & Research</h3>
                    <p class="small">Exploration-driven research supporting sustainable practices and long-term environmental resilience.</p>
                </div>
            </div>

            <a class="card program-feature" href="/swancityscuba/">
                <SwanMark size={56} />
                <div>
                    <div class="small program-kicker">Featured program</div>
                    <h3 style="margin:0 0 6px;">Swan City Scuba</h3>
                    <p class="small" style="margin:0;">
                        Our scuba education program in Lakeland, Florida. Students earn PADI certifications and learn to protect the
                        underwater places they explore, then join CESI cleanup, survey, and restoration dives.
                    </p>
                </div>
                <span class="btn primary">Learn to dive</span>
            </a>
        </section>

        <!-- GET INVOLVED -->
        <section class="section">
            <h2>Get involved</h2>
            <div class="grid3">
                <div class="card">
                    <h3 style="margin-top:0;">Volunteer</h3>
                    <p class="small">Help with projects, outreach, and community engagement.</p>
                    <a class="btn" href="/contact.html">Volunteer interest</a>
                </div>
                <div class="card">
                    <h3 style="margin-top:0;">Partner</h3>
                    <p class="small">Collaborate on programs, sponsor initiatives, or contribute expertise.</p>
                    <a class="btn" href="/contact.html">Partnership inquiry</a>
                </div>
                <div class="card">
                    <h3 style="margin-top:0;">Donate</h3>
                    <p class="small">Support CESI initiatives through our secure donation form.</p>
                    <a class="btn primary"
                       href="https://www.zeffy.com/en-US/donation-form/conservation-education-sustainability"
                       target="_blank"
                       rel="noopener noreferrer">
                        Donate via Zeffy
                    </a>
                </div>
            </div>
        </section>

        <!-- LEADERSHIP -->
        <section class="section">
            <h2>Leadership</h2>
            <div class="grid3">
                <div class="card">
                    <h3 style="margin-top:0;">Founder & Director</h3>
                    <p class="small"><strong>Dr. Frank Sposaro</strong></p>
                    <p class="small">Primary contact: <a href="mailto:secretary@cesi.earth">secretary@cesi.earth</a></p>
                </div>
                <div class="card">
                    <h3 style="margin-top:0;">Operating name</h3>
                    <p class="small">
                        The CESI Project operates as a DBA of
                        <strong>Sposaro Conservation, Education, Sustainability, Initiative INC</strong>.
                    </p>
                    <a class="btn" href="/legal.html">Read more</a>
                </div>
                <div class="card">
                    <h3 style="margin-top:0;">Transparency</h3>
                    <p class="small">
                        Key nonprofit documents (IRS letter, Form 990) will be published on the Legal page when available.
                    </p>
                    <a class="btn" href="/legal.html">Documents</a>
                </div>
            </div>
        </section>
</Site>
