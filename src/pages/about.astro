---
import Site from '../layouts/Site.astro';
---
<Site
    title='About — The CESI Project'
    description='Learn about The CESI Project and our mission to promote conservation, education, and sustainability through stewardship and community engagement.'
    ogTitle='About — The CESI Project'
    ogDescription='Mission, programs, and leadership of The CESI Project.'
    active="about"
>


        <section class="hero">
            <div class="hero-grid">
                <div class="card">
                    <h1 class="h1">About The CESI Project</h1>
                    <p class="lede">
                        Our mission is to promote conservation, education, and sustainability of Earth’s ecosystems and environments
                        through exploration, research, restoration, environmental stewardship, and global community engagement.
                    </p>

                    <div class="cta-row">
                        <a class="btn primary"
                           href="https://www.zeffy.com/en-US/donation-form/conservation-education-sustainability"
                           target="_blank"
                           rel="noopener noreferrer">
                            Donate
                        </a>
                        <a class="btn" href="/contact.html">Contact us</a>
                    </div>

                    <div class="pills">
                        <span class="pill">EIN: 41-2621387</span>
                        <span class="pill">Email: secretary@cesi.earth</span>
                    </div>
                </div>

                <div class="card">
                    <h2 style="margin:0 0 10px;">At a glance</h2>
                    <div class="kv"><div class="small">Focus</div><div>Conservation • Education • Sustainability</div></div>
                    <div class="kv"><div class="small">Methods</div><div>Exploration • Research • Restoration • Stewardship</div></div>
                    <div class="kv"><div class="small">Community</div><div>Local action with global engagement</div></div>
                    <div class="kv"><div class="small">Contact</div><div><a href="mailto:secretary@cesi.earth">secretary@cesi.earth</a></div></div>
                </div>
            </div>
        </section>

        <section class="section">
            <h2>Leadership</h2>
            <div class="grid3">
                <div class="card">
                    <h3 style="margin-top:0;">Founder & President</h3>
                    <p class="small"><strong>Dr. Frank Sposaro</strong></p>
                    <p class="small">President — <a href="mailto:drfrank@cesi.earth">drfrank@cesi.earth</a></p>
                    <p class="small" style="margin-top:8px;">Founded in 2025.</p>
                </div>

                <div class="card">
                    <h3 style="margin-top:0;">Treasurer</h3>
                    <p class="small"><strong>Stephanie Sposaro</strong></p>
                    <p class="small">Treasurer — <a href="mailto:steph@cesi.earth">steph@cesi.earth</a></p>
                </div>

                <div class="card">
                    <h3 style="margin-top:0;">Secretary</h3>
                    <p class="small"><strong>Jasper Lee</strong></p>
                    <p class="small">Secretary — <a href="mailto:jasper@cesi.earth">jasper@cesi.earth</a></p>
                </div>
                <div class="card">
                    <h3 style="margin-top:0;">Programs</h3>
                    <p class="small">Conservation & Restoration, Education & Outreach, Exploration & Research.</p>
                    <p class="small"><a href="/swancityscuba/"><strong>Swan City Scuba</strong></a>: scuba education for conservation.</p>
                </div>
                <div class="card">
                    <h3 style="margin-top:0;">Support our mission</h3>
                    <a class="btn primary"
                       href="https://www.zeffy.com/en-US/donation-form/conservation-education-sustainability"
                       target="_blank"
                       rel="noopener noreferrer">
                        Donate
                    </a>
                </div>
            </div>
        </section>

        <section class="section">
            <h2>Recent projects</h2>
            <div class="grid3">
                <div class="card project">
                    <div class="project-body">
                        <h3 style="margin-top:0;">Coastal Cleanup — Nassau</h3>
                        <p class="small">Organized a community-driven coastal cleanup in Nassau, removing marine debris from shorelines and restoring habitat while engaging local volunteers and partners in conservation stewardship.</p>
                    </div>
                </div>

                <div class="card">
                    <h3 style="margin-top:0;">Invasive Lionfish Removal</h3>
                    <p class="small">Conducted targeted lionfish removal dives off Florida's southeast coast to reduce pressure on native reef communities and protect biodiversity.</p>
                </div>

                <div class="card">
                    <h3 style="margin-top:0;">Advanced Diver Education (GUE)</h3>
                    <p class="small">Completed advanced training with Global Underwater Explorers (GUE) to enhance diver safety, awareness, and capability for complex scientific and conservation dives.</p>
                </div>
            </div>
        </section>
</Site>
