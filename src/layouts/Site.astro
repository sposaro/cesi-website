---
// Shared CESI layout: head, header/nav and footer for every page.
import '../styles/cesi.css';
import { org } from '../config/site';

export type NavKey = 'home' | 'about' | 'dive' | 'legal' | 'contact' | null;

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  active?: NavKey;
  noindex?: boolean;
}
const { title, description, ogTitle = title, ogDescription = description, active = null, noindex = false } = Astro.props;
const nav: { key: NavKey; href: string; label: string }[] = [
  { key: 'home', href: '/', label: 'Home' },
  { key: 'about', href: '/about.html', label: 'About' },
  { key: 'dive', href: '/swancityscuba/', label: 'Swan City Scuba' },
  { key: 'legal', href: '/legal.html', label: 'Legal' },
  { key: 'contact', href: '/contact.html', label: 'Contact' },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={description}>
    {noindex && <meta name="robots" content="noindex">}

    <!-- Open Graph / Social -->
    <meta property="og:title" content={ogTitle}>
    <meta property="og:description" content={ogDescription}>
    <meta property="og:type" content="website">
    <meta property="og:image" content="https://cesi.earth/assets/logo.png">

    <!-- Favicons -->
    <link rel="apple-touch-icon" sizes="57x57" href="/assets/icons/apple-icon-57x57.png">
    <link rel="apple-touch-icon" sizes="60x60" href="/assets/icons/apple-icon-60x60.png">
    <link rel="apple-touch-icon" sizes="72x72" href="/assets/icons/apple-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="76x76" href="/assets/icons/apple-icon-76x76.png">
    <link rel="apple-touch-icon" sizes="114x114" href="/assets/icons/apple-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="120x120" href="/assets/icons/apple-icon-120x120.png">
    <link rel="apple-touch-icon" sizes="144x144" href="/assets/icons/apple-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/assets/icons/apple-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/icons/android-icon-192x192.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/assets/icons/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/favicon-16x16.png">
    <link rel="manifest" href="/assets/icons/manifest.json">
    <meta name="msapplication-TileColor" content="#ffffff">
    <meta name="msapplication-TileImage" content="/assets/icons/ms-icon-144x144.png">
    <meta name="theme-color" content="#ffffff">
</head>

<body>
    <header class="nav">
        <div class="nav-inner">
            <a class="brand" href="/">
                <img src="/assets/logo.png" alt="The CESI Project logo">
                <div>
                    <div class="title">The CESI Project</div>
                    <div class="sub">Conservation • Education • Sustainability</div>
                </div>
            </a>

            <nav class="nav-links" aria-label="Main">
                {nav.map((n) => (
                    <a class={n.key === active ? 'active' : undefined} href={n.href} aria-current={n.key === active ? 'page' : undefined}>{n.label}</a>
                ))}
                <a class="donate" href={org.donateUrl} target="_blank" rel="noopener noreferrer">Donate</a>
            </nav>
        </div>
    </header>

    <slot name="subnav" />

    <main class="container">
        <slot />

        <section class="footer">
            © {year} The CESI Project · All rights reserved<br>
            EIN {org.ein} · <a href={`mailto:${org.email}`}>{org.email}</a> · <a class="social-footer" href={org.youtube} target="_blank" rel="noopener noreferrer" aria-label="CESI YouTube">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#ff0000" aria-hidden="true"><path d="M23.5 6.2s-.2-1.6-.8-2.3c-.8-1-1.7-1-2.1-1.1C16.7 2.5 12 2.5 12 2.5h-.1s-4.7 0-8.6.3c-.4 0-1.3.1-2.1 1.1-.6.8-.8 2.3-.8 2.3S0 8 0 9.8v2.4C0 14 .2 15.2.2 15.2s.2 1.6.8 2.3c.8 1 1.8 1 2.2 1.1 1.6.1 6.9.3 6.9.3h.1s4.7 0 8.6-.3c.4 0 1.3-.1 2.1-1.1.6-.8.8-2.3.8-2.3s.2-1.2.2-2.9v-2.4c0-1.8-.2-2.9-.2-2.9zM9.8 15.6V8.4l6.4 3.6-6.4 3.6z"/></svg>
                <span class="sr-only">YouTube</span>
            </a>
        </section>
    </main>
</body>
</html>
